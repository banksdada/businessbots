APP_NAME=Sorted
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://nowsorted.co.uk
LEGAL_DOMAIN=https://nowsorted.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=businessbots
DB_USERNAME=secret
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@businessbots.com"
MAIL_FROM_NAME="${APP_NAME}"
# Only set to false if your SMTP host's TLS certificate is issued to a
# different hostname than MAIL_HOST (e.g. a reseller webmail brand sitting
# in front of another provider's mail servers) but you trust it anyway.
# Leave unset/true for every normal provider — see config/mail.php.
MAIL_VERIFY_PEER=true

# Production sends through Postal over SMTP. Set MAIL_HOST, MAIL_PORT and
# MAIL_SCHEME in Coolify; local development keeps the Mailpit settings above.

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
BILLING_TRIAL_DAYS=14

# Meta (Instagram)
META_APP_ID=
META_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI="${APP_URL}/channels/instagram/callback"

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/channels/linkedin/callback"

# Google Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI="${APP_URL}/channels/gbp/callback"

# AI — any OpenAI-compatible /chat/completions endpoint works
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15

# Voice notes — "speak your problem" on the advice form.
# Default is the browser's free Web Speech API (runs on the client, no
# server cost, no API key). Set VOICE_PROVIDER=openai + VOICE_MODEL=whisper-1
# and an AI_API_KEY to route through Whisper instead, e.g. if your browser
# doesn't support speech recognition.
VOICE_PROVIDER=web_speech
VOICE_MODEL=

# Flux job alert notifier (python/jobs/job_alert_notifier.py) — emails
# JOB_ALERT_EMAIL_TO when Flux (a separate app) surfaces a job scoring at or
# above JOB_ALERT_SCORE_THRESHOLD. Uses the MAIL_* settings above to send.
FLUX_API_URL=https://fluxjobs.baseuse.xyz
JOB_ALERT_EMAIL_TO=bankoledada@gmail.com
JOB_ALERT_SCORE_THRESHOLD=65
# One of Flux's role keys — business_analyst, project, programme, delivery,
# agile_delivery, scrum_master (see skills_data.py ROLES in the Flux repo).
# Leave blank to get alerts for all target roles, not just this one.
JOB_ALERT_ROLE_FILTER=business_analyst

# AIOS CRM — a verified sign-up (magic link clicked) is POSTed here so the
# contact lands in the Clients sheet. The secret signs the body: HMAC-SHA256
# over "<timestamp>.<body>". Must match CRM_WEBHOOK_SECRET set on the AIOS
# side (Coolify). Leave blank locally to disable capture entirely.
CRM_WEBHOOK_URL=https://aios.webawesome.co.uk/webhook/crm
CRM_WEBHOOK_SECRET=

# OpenAI (DALL-E image generation — not covered by AI abstraction)
OPENAI_API_KEY=

# Python / PyRunner
DATABASE_URL=pgsql://secret:secret@postgres:5432/businessbots
REDIS_URL=redis://redis:6379
IMAGE_STORAGE_PATH=/shared-storage/generated-posts

# --- Client advice portal ---------------------------------------------------
# Social media features (paused). true brings them back.
FEATURE_SOCIAL=false
# false = clients can use the app without a Stripe subscription (invoice by hand)
BILLING_REQUIRED=false
# Who gets "draft ready" / "request failed" emails
PORTAL_OWNER_EMAIL=bankoledada@gmail.com
PORTAL_STUCK_AFTER_MINUTES=30
# Shared secret the PyRunner script sends as a Bearer token (make it long and random)
PYRUNNER_WORKER_TOKEN=
# The client-advice script's webhook URL from PyRunner (optional but faster)
PYRUNNER_ADVICE_WEBHOOK_URL=
