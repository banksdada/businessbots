APP_NAME=BusinessBots
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://automation.baseuse.xyz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=businessbots
DB_USERNAME=secret
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@businessbots.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
BILLING_TRIAL_DAYS=14

# Meta (WhatsApp / Instagram)
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_INSTAGRAM_REDIRECT_URI="${APP_URL}/channels/instagram/callback"
META_WHATSAPP_REDIRECT_URI="${APP_URL}/channels/whatsapp/callback"

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/channels/linkedin/callback"

# Google Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI="${APP_URL}/channels/gbp/callback"

# AI — any OpenAI-compatible /chat/completions endpoint works
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_CLASSIFICATION=gpt-4o-mini
AI_MODEL_REPLY=gpt-4o-mini
AI_TIMEOUT_SECONDS=15

# OpenAI (DALL-E image generation — not covered by AI abstraction)
OPENAI_API_KEY=

# Python / PyRunner
DATABASE_URL=pgsql://secret:secret@postgres:5432/businessbots
REDIS_URL=redis://redis:6379
IMAGE_STORAGE_PATH=/shared-storage/generated-posts
